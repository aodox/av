# ============================================================
# 腾讯云直播管理系统 - 环境变量配置
# ============================================================

# Tencent Cloud API 密钥
# 用于调用腾讯云API（如查询流状态、禁播等）
# 获取位置：腾讯云控制台 -> 访问管理 -> API密钥管理
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key

# 推流鉴权Key
# 获取位置：腾讯云控制台 -> 云直播 -> 域名管理 -> 推流域名 -> 管理 -> 鉴权配置
TENCENT_PUSH_AUTH_KEY=your_push_auth_key

# 播放鉴权Key
# 获取位置：腾讯云控制台 -> 云直播 -> 域名管理 -> 播放域名 -> 管理 -> 鉴权配置
TENCENT_PLAY_AUTH_KEY=your_play_auth_key

# MySQL 数据库密码
MYSQL_PASSWORD=your_mysql_password

# Redis 密码（如无密码可留空）
REDIS_PASSWORD=your_redis_password
